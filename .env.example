# Copiar a .env y completar. .env esta en .gitignore y nunca se commitea.
# La autenticacion es por key-pair RSA: no hay variable de password.

# --- Conexion Snowflake ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA_RAW=
SNOWFLAKE_SCHEMA_ANALYTICS=

# --- Autenticacion key-pair (elegir UNO de los dos modos) ---
# Modo local: ruta al archivo de clave privada PKCS8.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Modo CI: contenido PEM completo de la clave privada, en una sola variable.
SNOWFLAKE_PRIVATE_KEY=
# Passphrase de la clave privada. Vacio si la clave se genero sin cifrar.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Objetos de ingesta ---
SNOWFLAKE_STAGE=
SNOWFLAKE_FILE_FORMAT=
SNOWFLAKE_RAW_TABLE=

# --- Rutas locales (opcional: hay defaults relativos al repo) ---
LANDING_DIR=
STAGING_DIR=
WEB_DATA_DIR=
