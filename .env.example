# Copiar a .env y completar. .env esta en .gitignore y nunca se commitea.
# La autenticacion es por key-pair RSA: no hay variable de password.
# Lo leen los scripts (python-dotenv) y `dagster dev`, que carga el .env solo.
# dbt no lo lee: en PowerShell, `. .\scripts\load_env.ps1` antes de correrlo.

# --- Conexion Snowflake ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA_RAW=
SNOWFLAKE_SCHEMA_ANALYTICS=

# --- Autenticacion key-pair (elegir UNO de los dos modos) ---
# Ruta al archivo de clave privada PKCS8, fuera del repo. Es el modo de local
# y tambien el de GitHub Actions, que escribe el secret a un archivo temporal.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Alternativa: el PEM completo en una variable (lo acepta load.py, no dbt).
SNOWFLAKE_PRIVATE_KEY=
# Passphrase de la clave privada. Vacio si la clave se genero sin cifrar.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Objetos de ingesta ---
SNOWFLAKE_STAGE=
SNOWFLAKE_FILE_FORMAT=
SNOWFLAKE_RAW_TABLE=

# --- Rutas locales (opcional: hay defaults relativos al repo) ---
LANDING_DIR=
STAGING_DIR=
WEB_DATA_DIR=

# --- Dagster / dbt ---
# Directorio de storage de Dagster (gitignoreado). Vacio: `dagster dev` usa uno temporal.
DAGSTER_HOME=
# Target de profiles.yml: dev en local, ci en GitHub Actions.
DBT_TARGET=

# --- Agente de consulta (agent/) ---
# Key con alcance de espacio de trabajo, no de organizacion.
ANTHROPIC_API_KEY=
AGENT_MODEL=
AGENT_EFFORT=
